# Jira API (reuse token from jira-mcp-server .env if available)
JIRA_SERVER=https://deept.atlassian.net
JIRA_TOKEN=your_jira_api_token_here

# Optional: override JQL (default: all ADINC tickets)
# ADINC_JQL=project = ADINC ORDER BY created DESC

# Email — Disney/Outlook SMTP example (adjust for your org)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your.name@disney.com
SMTP_PASSWORD=your_app_password_or_smtp_secret

EMAIL_FROM=your.name@disney.com
EMAIL_TO=teammate1@disney.com,teammate2@disney.com

# Optional custom subject
# EMAIL_SUBJECT=ADINC Weekly Audit Report
